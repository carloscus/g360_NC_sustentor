# AI assistant
.antigravitycli/
.kilo/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Runtime: single-instance (se crean al arrancar la app).
# El .pid lo escribe la instancia viva para que un arranque bloqueado pueda
# decir a quien cerrar en vez de obligar a buscarlo en el Administrador.
.app_instance.lock
.app_instance.pid
