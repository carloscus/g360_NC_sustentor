# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Entornos virtuales
.venv/
venv/
ENV/

# Distribucion y Builds
dist/
build/
*.spec

# Portable
*-portable/
uv.exe
uvx.exe
run_log.txt

# Excel y Datos (Ignorar salidas, mantener plantillas)
*.xlsx
*.xls
!assets/templates/*.xlsx
!assets/templates/*.xls

# Logs y Temporales
dev_logs/
*.log
.vscode/
.idea/

# OS
.DS_Store
desktop.ini
Thumbs.db

# Environment
.env
.env.local

# AI assistant
.antigravitycli/
.kilo/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Runtime: single-instance (se crean al arrancar la app).
# El .pid lo escribe la instancia viva para que un arranque bloqueado pueda
# decir a quien cerrar en vez de obligar a buscarlo en el Administrador.
.app_instance.lock
.app_instance.pid

# Cache de ruff (0 KB pero aparece como untracked en cada `git status`).
.ruff_cache/

# Dependencias y generados del toolchain de presentaciones (se regeneran
# con `npm install --prefix .slides` y `emit_tokens.py`; solo brand.json,
# el spec y el build script se versionan).
.slides/node_modules/
.slides/package.json
.slides/package-lock.json
.slides/tokens.cjs
