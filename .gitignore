*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Entornos virtuales
.venv/
venv/
ENV/

# Distribucion y Builds
dist/
build/
*.spec

# Portable
*-portable/
uv.exe
uvx.exe
run_log.txt

# Excel y Datos (Ignorar salidas, mantener plantillas)
*.xlsx
*.xls
!assets/templates/*.xlsx
!assets/templates/*.xls

